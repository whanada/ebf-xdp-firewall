[Unit]
Description=XDP firewall management containers
Requires=docker.service xdp-firewall.service
After=docker.service xdp-firewall.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ firewall_root }}
ExecStart=/usr/bin/python3 {{ firewall_root }}/scripts/compose.py up -d
ExecStop=/usr/bin/python3 {{ firewall_root }}/scripts/compose.py down
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
