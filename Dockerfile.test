FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends clang gcc make libbpf-dev libelf-dev zlib1g-dev bpftool iproute2 ethtool python3 python3-yaml ansible-core curl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN make all
CMD ["make", "test"]
